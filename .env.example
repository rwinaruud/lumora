# Server-side only. Create the Supabase Storage bucket as PRIVATE before use.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Server-side only. Configure the Stripe secret key from the Stripe dashboard.
STRIPE_SECRET_KEY=

# Public app origin used for Checkout return URLs; use https:// in production.
APP_BASE_URL=

# Public Google Analytics 4 Measurement ID (not a secret). Analytics is disabled when empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
